# Copie a .env y ajuste. Nunca suba .env al repositorio.
NUAM_ENV=desarrollo            # use "produccion" para exigir JWT_SECRET
JWT_SECRET=cambie-esto-por-una-clave-larga-y-aleatoria-de-32-caracteres-o-mas
NUAM_DSN=host=localhost port=5432 dbname=nuam user=postgres password=postgres
POOL_MAX=40
NUAM_STORAGE=local             # local | s3
NUAM_STORAGE_DIR=./data/storage
# NUAM_S3_BUCKET=nuam-certificados
# NUAM_S3_ENDPOINT=              # opcional (MinIO u otro compatible con S3)
